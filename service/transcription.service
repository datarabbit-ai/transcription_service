[Unit]
Description=Bugs app service
After=docker.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=true
RestartSec=1
User=wsmura
WorkingDirectory=/home/wsmura/projects/transcription_service
ExecStart=docker-compose -f docker/docker-compose.yml up -d
ExecStop=docker-compose -f docker/docker-compose.yml down

[Install]
WantedBy=multi-user.target
